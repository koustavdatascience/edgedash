# EdgeDash Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should never be committed

# LLM Provider Configuration
LLM_PROVIDER=gemini

# For Gemini (Google AI) - ADD YOUR API KEY HERE
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# For Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

# Database Configuration
# For SQLite (default): Set db_backend: sqlite in config.yaml
# For Postgres: Set db_backend: postgres in config.yaml and provide DATABASE_URL
# DATABASE_URL=postgresql://user:password@localhost:5432/edgedash
